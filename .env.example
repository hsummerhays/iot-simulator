# AWS IoT Simulator Configuration
# Copy this file to .env and fill in your actual AWS IoT parameters

# AWS IoT Core ATS Endpoint (e.g., <prefix>-ats.iot.<region>.amazonaws.com)
AWS_IOT_ENDPOINT=your-endpoint-prefix-ats.iot.us-east-1.amazonaws.com

# MQTT Client ID registered or permitted in your IoT Policy
AWS_IOT_CLIENT_ID=basicPubSub

# MQTT Topic to publish telemetry
AWS_IOT_TOPIC=sdk/test/python

# Certificate filenames (placed inside ./certs/ directory)
AWS_IOT_CERT_FILE=your-certificate.pem.crt
AWS_IOT_KEY_FILE=your-private.pem.key
AWS_IOT_ROOT_CA_FILE=AmazonRootCA1.pem

# Telemetry Simulation Parameters (Optional)
SIM_PUBLISH_INTERVAL_SECS=5.0
SIM_BASE_TEMP=25.0
SIM_TEMP_VARIATION=1.5

# Optional: Certificate ID for diagnostics (check_iot_config.ps1)
AWS_IOT_CERT_ID=your-64-character-certificate-id
AWS_REGION=us-east-1
